{
  "name": "gta",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Open-world arcade driving game for CrazyGames",
  "scripts": {
    "start": "npm run build && npm run preview",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node tools/budget.mjs",
    "smoke": "playwright test e2e/smoke.spec.ts",
    "perf": "playwright test e2e/perf.spec.ts",
    "perf:headed": "playwright test e2e/perf.spec.ts --headed",
    "screens": "playwright test e2e/screens.spec.ts",
    "city": "playwright test e2e/city.spec.ts",
    "life": "playwright test e2e/life.spec.ts",
    "heat": "playwright test e2e/heat.spec.ts",
    "verify": "node tools/verify.mjs",
    "verify:gate": "node tools/verify.mjs --gate",
    "test:long": "node tools/verify.mjs test --gate"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
